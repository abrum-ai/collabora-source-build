# MPL-2.0. Disposable source-fetch tool, never part of the delivered runtime.
FROM docker.io/library/alpine:3.21@sha256:ce64758a109eb420d874a118f87920e625e12d3634e03b4a5573fd9f6e5d3507
RUN apk add --no-cache abuild git tar gzip curl ca-certificates && \
    addgroup -g 1001 fetcher && adduser -D -u 1001 -G fetcher fetcher
USER 1001:1001
ENV HOME=/tmp/source-home
ENTRYPOINT ["/bin/sh"]
